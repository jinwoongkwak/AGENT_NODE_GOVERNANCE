{
 "schema": 1,
 "status": "active",
 "protocol_version": "1.3.0",
 "admin_doc": "Architecture/Frontmatter_admin.md",
 "notice": "HQ가 승인한 규칙입니다. Frontmatter_admin.md가 사람이 읽는 정본이고 이 파일이 같은 규칙의 기계 판독판입니다. 규칙을 바꾸려면 admin 문서를 먼저 고치고 승인받은 뒤 이 파일을 맞춥니다.",
 "conventions": {
  "list_style": "block",
  "empty_list": "[]",
  "empty_required_value": "키를 두고 값을 비움. 본문에 '확인 필요'를 적음",
  "empty_optional_value": "키를 두고 값을 비움. 키를 지우지 않음",
  "date": "YYYY-MM-DD",
  "datetime": "작업 관리 도구가 쓰는 ISO 8601 (YYYY-MM-DDTHH:MM:SS.sss±HH:MM)",
  "link": "\"[[vault 기준 전체 경로|표시 이름]]\" 형태로 큰따옴표를 붙임. 연결할 문서가 있으면 항상 링크로 쓰고, 링크를 만들 수 없을 때만 한 줄 문자열",
  "key_case": "snake_case. 작업 관리 도구가 정한 키(blockedBy, dateCreated 등)는 plugin_keys의 이름을 그대로 씀",
  "key_order": "각 kind의 order를 따름. order에 없는 도구 관리 키는 맨 뒤",
  "one_line": "text 값은 한 줄. 문장·링크·마크다운 강조를 넣지 않음",
  "ai_authored": "AI가 초안을 쓰거나 고친 문서는 llm_model에 그 모델 이름을 적음. 사람이 쓴 문서는 키를 두고 값을 비움"
 },
 "types": {
  "text": {"meaning": "한 줄 문자열"},
  "int": {"meaning": "정수", "pattern": "^-?[0-9]+$"},
  "bool": {"meaning": "true 또는 false", "pattern": "^(true|false)$"},
  "date": {"meaning": "날짜", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
  "date_or_datetime": {"meaning": "날짜 또는 날짜와 시각", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+(Z|[+-][0-9]{2}:[0-9]{2})?)?$"},
  "link": {"meaning": "Obsidian 링크", "pattern": "^\\[\\[[^\\]]+\\]\\]$"},
  "link_or_text": {"meaning": "Obsidian 링크. 링크를 만들 수 없을 때만 한 줄 문자열", "pattern": "^(\\[\\[[^\\]]+\\]\\]|[^\\[\\]]+)$"},
  "version": {"meaning": "V<major>.<minor>.<patch>", "pattern": "^V[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "commit": {"meaning": "git commit 해시 7–40자", "pattern": "^[0-9a-f]{7,40}$"},
  "enum": {"meaning": "values의 키 중 하나"},
  "list": {"meaning": "블록 목록. item_type이 각 항목의 형식"}
 },
 "placeholders": {
  "hq-owner": {"meaning": "HQ 사람의 owner 값", "default": null},
  "task-folder": {"meaning": "TaskNote 최상위 폴더", "default": null},
  "projects-folder": {"meaning": "프로젝트 폴더", "default": null},
  "technical-wiki": {"meaning": "기술 Wiki 폴더", "default": null},
  "theory-wiki": {"meaning": "이론 Wiki 폴더", "default": null},
  "contexts": {"meaning": "TaskNote contexts 허용 값", "default": null},
  "recommended-models": {"meaning": "recommended_model 허용 값. 작업 난이도에 맞는 모델", "default": {"Claude Haiku 4.5": "난이도 낮음: 정해진 절차, 단순 수집·편집", "GPT-5 mini": "난이도 낮음: 정해진 절차, 단순 수집·편집", "Claude Sonnet 5": "난이도 보통: 일반 실행, 문서 작성, 코드 수정", "GPT-5": "난이도 보통: 일반 실행, 문서 작성, 코드 수정", "Claude Opus 5": "난이도 높음: 설계·다단계 추론, 위험도 2 작업", "GPT-5 Pro": "난이도 높음: 설계·다단계 추론, 위험도 2 작업"}},
  "project-status": {"meaning": "STATUS status 허용 값", "default": {"idea": "착수 전 구상", "active": "진행 중", "paused": "일시 중단", "closing": "마무리 중", "archived": "종료·보관"}},
  "project-phases": {"meaning": "STATUS phase 허용 값", "default": {"research": "조사", "design": "설계", "verification": "검증", "publication": "발표·출판"}},
  "project-id-pattern": {"meaning": "프로젝트 ID 정규식", "default": "^.+$"},
  "readme-tracks": {"meaning": "README track 허용 값", "default": null},
  "languages": {"meaning": "Wiki language 허용 값", "default": {"KR": "한국어", "EN": "영어"}}
 },
 "kinds": {
  "tasknote": {
   "match": {"under": "{task-folder}", "tag": "task", "exclude_under": ["{task-folder}/Views"]},
   "variants": {"ai": "tags에 ai가 있음", "human": "tags에 admin이 있는 그 밖의 task"},
   "order": ["title", "status", "tags", "projects", "contexts", "owner", "hq_todo", "risk", "llm_model", "proposal_version", "approved_version", "recommended_model", "execution_mode", "report_policy", "write_scope", "blockedBy", "scheduled", "due", "completedDate", "timeEstimate", "ForToday", "waiting", "dateCreated", "dateModified"],
   "fields": {
    "title": {"required": ["ai", "human"], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "파일 이름과 같은 제목"},
    "status": {"required": ["ai", "human"], "type": "enum", "set_by": "agent", "change_risk": 1,
     "values": {"to-do": "시작 전", "in-progress": "진행 중", "delayed": "미루었거나 다시 볼 조건을 기다림", "done": "완료", "archived": "보관 (작업 관리 도구가 완료로 취급)"},
     "legacy_values": {"completed": "done으로 읽음", "shelved": "delayed로 바꿈"}},
    "tags": {"required": ["ai", "human"], "type": "list", "item_type": "text", "set_by": "agent", "change_risk": 1,
     "must_include": {"ai": ["task", "ai"], "human": ["task", "admin"]},
     "reserved": {"task": "작업 관리 도구가 task로 인식", "ai": "AI TaskNote", "admin": "사람 TaskNote", "archived": "보관한 task"}},
    "projects": {"required": ["ai"], "type": "list", "item_type": "link_or_text", "set_by": "agent", "change_risk": 1, "meaning": "프로젝트 README 또는 색인 링크. 링크를 만들 수 없을 때만 텍스트"},
    "contexts": {"required": [], "type": "list", "item_type": "enum", "values_from": "contexts", "set_by": "agent", "change_risk": 1, "meaning": "AI가 쓰고 HQ가 확인"},
    "owner": {"required": ["ai"], "type": "enum", "set_by": "agent", "change_risk": 1,
     "values": {"ai": "AI가 다음 행동", "{hq-owner}": "HQ가 다음 행동", "none": "종료"}},
    "hq_todo": {"required": ["ai"], "type": "enum", "set_by": "agent", "change_risk": 1,
     "values": {"none": "HQ 할 일 없음", "decide": "선택·승인", "dispatch": "실행 지시", "review": "결과 검토"}},
    "risk": {"required": ["ai"], "type": "enum", "set_by": "agent", "change_risk": 1,
     "values": {"0": "읽기·분석", "1": "범위 안의 되돌릴 수 있는 수정", "2": "이동·삭제·설정·외부 전송·대량 수정"}},
    "llm_model": {"required": ["ai"], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "이 문서를 쓴 모델 이름 (예: Claude Sonnet 5, GPT-5)"},
    "proposal_version": {"required": ["ai"], "type": "version", "set_by": "agent", "change_risk": 1},
    "approved_version": {"required": ["ai"], "type": "version", "allow_empty": true, "set_by": "agent", "change_risk": 1, "meaning": "HQ 승인 원문이 있을 때만 채움. 미승인은 \"\""},
    "recommended_model": {"required": ["ai"], "type": "enum", "values_from": "recommended-models", "set_by": "agent", "change_risk": 1, "meaning": "실행할 작업의 난이도에 맞는 모델 추천. HQ가 바꿀 수 있음"},
    "execution_mode": {"required": ["ai"], "type": "enum", "set_by": "hq", "change_risk": 1,
     "values": {"autonomous": "승인 없이 실행", "after-approval": "승인하면 바로 실행", "manual": "승인 뒤 실행 지시를 기다림"}},
    "report_policy": {"required": ["ai"], "type": "enum", "set_by": "hq", "change_risk": 1,
     "values": {"decision-only": "결정이 필요할 때만", "milestone": "단계마다", "final": "끝에 한 번"}},
    "write_scope": {"required": ["ai"], "type": "list", "item_type": "text", "set_by": "hq", "change_risk": 1, "meaning": "vault 기준 경로"},
    "blockedBy": {"required": [], "type": "list", "item_type": "link", "set_by": "agent", "change_risk": 1, "plugin_key": true, "meaning": "먼저 끝나야 하는 task 링크. 외부 조건은 본문"},
    "scheduled": {"required": [], "type": "date_or_datetime", "set_by": "hq", "change_risk": 1, "plugin_key": true},
    "due": {"required": [], "type": "date_or_datetime", "set_by": "hq", "change_risk": 1, "plugin_key": true},
    "completedDate": {"required": [], "type": "date", "set_by": "plugin", "change_risk": 1, "plugin_key": true},
    "timeEstimate": {"required": [], "type": "int", "set_by": "hq", "change_risk": 1, "plugin_key": true, "meaning": "분"},
    "ForToday": {"required": [], "type": "bool", "set_by": "hq", "change_risk": 1, "variant_only": "human", "meaning": "오늘 할 일 표시"},
    "waiting": {"required": [], "type": "bool", "set_by": "hq", "change_risk": 1, "variant_only": "human", "meaning": "외부 대기"},
    "dateCreated": {"required": [], "type": "date_or_datetime", "set_by": "plugin", "change_risk": 1, "plugin_key": true},
    "dateModified": {"required": [], "type": "date_or_datetime", "set_by": "plugin", "change_risk": 1, "plugin_key": true}
   },
   "state_combination_fields": ["status", "owner", "hq_todo"],
   "state_combinations": [["to-do", "{hq-owner}", "decide"], ["to-do", "{hq-owner}", "dispatch"], ["to-do", "ai", "none"], ["in-progress", "ai", "none"], ["done", "{hq-owner}", "review"], ["done", "none", "none"]],
   "state_combinations_apply_to": "ai",
   "plugin_managed": ["timeEntries", "recurrence", "recurrence_anchor", "recurrence_parent", "complete_instances", "skipped_instances", "reminders", "pomodoros", "tasknotes_manual_order", "icsEventId", "googleCalendarEventId"],
   "deprecated": {"blocked_by": "blockedBy", "project": "projects", "hq": "hq_todo", "priority": "(삭제)", "urgency": "(삭제)"}
  },
  "project_status": {
   "match": {"under": "{projects-folder}", "filename": "STATUS.md"},
   "order": ["project_id", "status", "phase", "next_action", "next_deadline", "updated", "draft_by", "llm_model"],
   "fields": {
    "project_id": {"required": ["all"], "type": "text", "pattern_from": "project-id-pattern", "set_by": "agent", "change_risk": 1},
    "status": {"required": ["all"], "type": "enum", "values_from": "project-status", "set_by": "hq", "change_risk": 2},
    "phase": {"required": ["all"], "type": "enum", "values_from": "project-phases", "set_by": "hq", "change_risk": 2},
    "next_action": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "구체적 행동 하나"},
    "next_deadline": {"required": ["all"], "type": "date", "allow_empty": true, "set_by": "hq", "change_risk": 2},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "draft_by": {"required": [], "type": "link_or_text", "set_by": "agent", "change_risk": 1, "meaning": "AI가 쓴 초안의 TaskNote 링크 또는 legacy ID"},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "draft_by가 있으면 그 초안을 만든 모델 이름"}
   },
   "deprecated": {"priority": "(삭제)"}
  },
  "project_readme": {
   "match": {"under": "{projects-folder}", "filename": "README.md", "depth_max": 3, "has_key": "project_id"},
   "order": ["project_id", "type", "collaborators", "track", "created", "draft_by", "llm_model"],
   "fields": {
    "project_id": {"required": ["all"], "type": "text", "pattern_from": "project-id-pattern", "set_by": "agent", "change_risk": 1},
    "type": {"required": ["all"], "type": "enum", "set_by": "hq", "change_risk": 1, "values": {"project-brief": "일반 프로젝트", "collaboration": "공동 연구 프로젝트"}},
    "collaborators": {"required": [], "type": "list", "item_type": "link_or_text", "set_by": "hq", "change_risk": 1, "meaning": "사람·기관 문서가 있으면 링크"},
    "track": {"required": [], "type": "enum", "values_from": "readme-tracks", "set_by": "hq", "change_risk": 1},
    "created": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "draft_by": {"required": [], "type": "link_or_text", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "draft_by가 있으면 그 초안을 만든 모델 이름"}
   },
   "deprecated": {"codename": "(삭제)", "partners": "collaborators"}
  },
  "decision_log": {
   "match": {"filename": "Decisions.md"},
   "order": ["project_id", "type", "updated", "llm_model"],
   "fields": {
    "project_id": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "프로젝트 ID 또는 HQ"},
    "type": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"decision-log": "결정 기록"}},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "AI가 썼으면 그 모델 이름"}
   }
  },
  "index": {
   "match": {"type_value": ["project-index", "technical-index", "theory-index", "repository-catalog"]},
   "order": ["type", "updated", "llm_model"],
   "fields": {
    "type": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"project-index": "프로젝트 현황 표", "technical-index": "기술 Wiki 색인", "theory-index": "이론 Wiki 색인", "repository-catalog": "저장소 목록"}},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "AI가 썼으면 그 모델 이름"}
   }
  },
  "repo_card": {
   "match": {"under": "{technical-wiki}", "type_value": ["repo-card"]},
   "order": ["type", "repo", "remote", "local_path", "branch", "last_checked_commit", "status", "updated", "llm_model"],
   "fields": {
    "type": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"repo-card": "저장소 카드"}},
    "repo": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "remote": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "local_path": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "branch": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "last_checked_commit": {"required": ["all"], "type": "commit", "set_by": "agent", "change_risk": 1},
    "status": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"active": "사용 중", "archived": "보관"}},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "AI가 썼으면 그 모델 이름"}
   }
  },
  "technical_wiki": {
   "match": {"under": "{technical-wiki}"},
   "order": ["title", "type", "tags", "source_project", "status", "created", "updated", "related", "llm_model"],
   "fields": {
    "title": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1},
    "type": {"required": [], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"note": "일반 기술 노트", "external-media": "외부 자료 요약"}},
    "tags": {"required": ["all"], "type": "list", "item_type": "text", "set_by": "agent", "change_risk": 1},
    "source_project": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "처음 나온 프로젝트 ID"},
    "status": {"required": [], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"active": "유지 중", "done": "완결"}},
    "created": {"required": [], "type": "date", "set_by": "agent", "change_risk": 1},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "related": {"required": [], "type": "list", "item_type": "link", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "AI가 썼으면 그 모델 이름"}
   },
   "missing_frontmatter": "frontmatter가 없는 노트에는 order의 필드를 모두 넣고, 값을 모르면 키만 두고 비움"
  },
  "theory_wiki": {
   "match": {"under": "{theory-wiki}"},
   "order": ["author", "affiliation", "tags", "created", "updated", "language", "sources", "llm_model"],
   "fields": {
    "author": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "affiliation": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "tags": {"required": ["all"], "type": "list", "item_type": "text", "set_by": "agent", "change_risk": 1},
    "created": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "language": {"required": ["all"], "type": "enum", "values_from": "languages", "set_by": "agent", "change_risk": 1},
    "sources": {"required": ["all"], "type": "list", "item_type": "text", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "AI가 썼으면 그 모델 이름"}
   },
   "deprecated": {"aliases": "(삭제)", "translation": "(삭제)", "related": "(삭제)"}
  }
 },
 "no_frontmatter": ["_AI/CONTEXT.md"],
 "hq_decided": [
  {"id": "Q1", "kind": "tasknote", "field": "status", "decision": "legacy 값 shelved는 delayed로 바꾸고 delayed를 허용 값에 추가"},
  {"id": "Q2", "kind": "tasknote", "field": "urgency, ForToday, waiting, blockedBy", "decision": "urgency만 삭제. ForToday·waiting은 true/false로 유지하고 blockedBy는 별도 링크 필드로 둠"},
  {"id": "Q3", "kind": "tasknote", "field": "projects", "decision": "연결할 문서가 있으면 링크로 쓰고, 링크를 만들 수 없을 때만 텍스트 (link_or_text)"},
  {"id": "Q4", "kind": "(전체)", "field": "priority", "decision": "모든 kind에서 삭제"},
  {"id": "Q5", "kind": "project_readme", "field": "type", "decision": "공동 연구 README는 collaboration"},
  {"id": "Q6", "kind": "technical_wiki", "field": "(전체)", "decision": "frontmatter가 없는 노트에 order의 필드를 모두 넣고, status에는 설명 문장을 쓰지 않음"},
  {"id": "Q7", "kind": "(전체)", "field": "빈 선택 값", "decision": "값이 없는 선택 필드도 키는 두고 값만 비움"}
 ]
}
