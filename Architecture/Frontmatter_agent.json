{
 "schema": 1,
 "status": "active",
 "protocol_version": "1.6.0",
 "admin_doc": "Architecture/Frontmatter_admin.md",
 "notice": "Rules approved by HQ. Frontmatter_admin.md is the human-readable canonical source and this file is the machine-readable version of the same rules. To change a rule, edit and get approval for the admin document first, then align this file.",
 "conventions": {
  "list_style": "block",
  "empty_list": "[]",
  "empty_required_value": "Keep the key with an empty value. Write '확인 필요' in the body",
  "empty_optional_value": "Keep the key with an empty value. Never remove the key",
  "date": "YYYY-MM-DD",
  "datetime": "ISO 8601 as written by the task management tool (YYYY-MM-DDTHH:MM:SS.sss±HH:MM)",
  "link": "Quoted as \"[[full vault path|display name]]\". Always use a link when a target document exists; a one-line string only when a link cannot be made",
  "key_case": "snake_case. Keys defined by the task management tool (blockedBy, dateCreated, etc.) keep their plugin_keys names",
  "key_order": "Follow each kind's order. Tool-managed keys not in order go last",
  "one_line": "text values are one line. No sentences, links, or Markdown emphasis",
  "ai_authored": "Documents drafted or edited by AI record the model name in llm_model. Documents written by a person keep the key with an empty value"
 },
 "types": {
  "text": {"meaning": "One-line string"},
  "int": {"meaning": "Integer", "pattern": "^-?[0-9]+$"},
  "bool": {"meaning": "true or false", "pattern": "^(true|false)$"},
  "date": {"meaning": "Date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
  "date_or_datetime": {"meaning": "Date, or date and time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+(Z|[+-][0-9]{2}:[0-9]{2})?)?$"},
  "link": {"meaning": "Obsidian link", "pattern": "^\\[\\[[^\\]]+\\]\\]$"},
  "link_or_text": {"meaning": "Obsidian link. A one-line string only when a link cannot be made", "pattern": "^(\\[\\[[^\\]]+\\]\\]|[^\\[\\]]+)$"},
  "version": {"meaning": "V<major>.<minor>.<patch>", "pattern": "^V[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "commit": {"meaning": "git commit hash, 7–40 characters", "pattern": "^[0-9a-f]{7,40}$"},
  "enum": {"meaning": "One of the keys in values"},
  "list": {"meaning": "Block list. item_type is the format of each item"}
 },
 "placeholders": {
  "hq-owner": {"meaning": "owner value of the HQ person", "default": null},
  "task-folder": {"meaning": "Top-level TaskNote folder", "default": null},
  "projects-folder": {"meaning": "Projects folder", "default": null},
  "technical-wiki": {"meaning": "Technical Wiki folder", "default": null},
  "theory-wiki": {"meaning": "Theory Wiki folder", "default": null},
  "contexts": {"meaning": "Allowed values for TaskNote contexts", "default": null},
  "recommended-models": {"meaning": "Allowed values for recommended_model. A model matching task difficulty", "default": {"Claude Haiku 4.5": "Low difficulty: fixed procedures, simple collection and editing", "GPT-5 mini": "Low difficulty: fixed procedures, simple collection and editing", "Claude Sonnet 5": "Medium difficulty: ordinary execution, writing documents, editing code", "GPT-5": "Medium difficulty: ordinary execution, writing documents, editing code", "Claude Opus 5": "High difficulty: design, multi-step reasoning, risk-level-2 work", "GPT-5 Pro": "High difficulty: design, multi-step reasoning, risk-level-2 work"}},
  "project-status": {"meaning": "Allowed values for STATUS status", "default": {"idea": "Idea before start", "active": "In progress", "paused": "Paused", "closing": "Closing out", "archived": "Closed and archived"}},
  "project-phases": {"meaning": "Allowed values for STATUS phase", "default": {"research": "Research", "design": "Design", "verification": "Verification", "publication": "Presentation and publication"}},
  "project-id-pattern": {"meaning": "Project ID regular expression", "default": "^.+$"},
  "readme-tracks": {"meaning": "Allowed values for README track", "default": null},
  "languages": {"meaning": "Allowed values for Wiki language", "default": {"KR": "Korean", "EN": "English"}}
 },
 "kinds": {
  "tasknote": {
   "match": {"under": "{task-folder}", "tag": "task", "exclude_under": ["{task-folder}/Views"]},
   "variants": {"ai": "tags include ai", "human": "Other tasks whose tags include admin"},
   "order": ["title", "status", "tags", "projects", "contexts", "owner", "hq_todo", "risk", "llm_model", "proposal_version", "approved_version", "recommended_model", "execution_mode", "report_policy", "write_scope", "blockedBy", "scheduled", "due", "completedDate", "timeEstimate", "ForToday", "waiting", "dateCreated", "dateModified"],
   "fields": {
    "title": {"required": ["ai", "human"], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "Title equal to the file name"},
    "status": {"required": ["ai", "human"], "type": "enum", "set_by": "agent", "change_risk": 1,
     "values": {"to-do": "Not started", "in-progress": "In progress", "delayed": "Postponed or waiting for a condition to revisit", "done": "Done", "archived": "Archived (the task management tool treats it as done)"},
     "legacy_values": {"completed": "Read as done", "shelved": "Change to delayed"}},
    "tags": {"required": ["ai", "human"], "type": "list", "item_type": "text", "set_by": "agent", "change_risk": 1,
     "must_include": {"ai": ["task", "ai"], "human": ["task", "admin"]},
     "reserved": {"task": "Recognized as a task by the task management tool", "ai": "AI TaskNote", "admin": "Human TaskNote", "archived": "Archived task"}},
    "projects": {"required": ["ai"], "type": "list", "item_type": "link_or_text", "set_by": "agent", "change_risk": 1, "meaning": "Link to the project README or index. Text only when a link cannot be made"},
    "contexts": {"required": [], "type": "list", "item_type": "enum", "values_from": "contexts", "set_by": "agent", "change_risk": 1, "meaning": "Written by AI, confirmed by HQ"},
    "owner": {"required": ["ai"], "type": "enum", "set_by": "agent", "change_risk": 1,
     "values": {"ai": "AI acts next", "{hq-owner}": "HQ acts next", "none": "Closed"}},
    "hq_todo": {"required": ["ai"], "type": "enum", "set_by": "agent", "change_risk": 1,
     "values": {"none": "Nothing for HQ", "decide": "Choose or approve", "dispatch": "Dispatch", "review": "Review results"}},
    "risk": {"required": ["ai"], "type": "enum", "set_by": "agent", "change_risk": 1,
     "values": {"0": "Read and analyze", "1": "Reversible edits within scope", "2": "Move, delete, settings, external transfer, bulk edits"}},
    "llm_model": {"required": ["ai"], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "Name of the model that wrote this document (e.g., Claude Sonnet 5, GPT-5)"},
    "proposal_version": {"required": ["ai"], "type": "version", "set_by": "agent", "change_risk": 1},
    "approved_version": {"required": ["ai"], "type": "version", "allow_empty": true, "set_by": "agent", "change_risk": 1, "meaning": "Filled only when HQ's original approval text exists. Unapproved is \"\""},
    "recommended_model": {"required": ["ai"], "type": "enum", "values_from": "recommended-models", "set_by": "agent", "change_risk": 1, "meaning": "Recommended model for the difficulty of the work. HQ may change it"},
    "execution_mode": {"required": ["ai"], "type": "enum", "set_by": "hq", "change_risk": 1,
     "values": {"autonomous": "Execute without approval", "after-approval": "Execute immediately on approval", "manual": "Wait for a dispatch order after approval"}},
    "report_policy": {"required": ["ai"], "type": "enum", "set_by": "hq", "change_risk": 1,
     "values": {"decision-only": "Only when a decision is needed", "milestone": "At each milestone", "final": "Once at the end"}},
    "write_scope": {"required": ["ai"], "type": "list", "item_type": "text", "set_by": "hq", "change_risk": 1, "meaning": "Paths relative to the vault"},
    "blockedBy": {"required": [], "type": "list", "item_type": "link", "set_by": "agent", "change_risk": 1, "plugin_key": true, "meaning": "Links to tasks that must finish first. External conditions go in the body"},
    "scheduled": {"required": [], "type": "date_or_datetime", "set_by": "hq", "change_risk": 1, "plugin_key": true},
    "due": {"required": [], "type": "date_or_datetime", "set_by": "hq", "change_risk": 1, "plugin_key": true},
    "completedDate": {"required": [], "type": "date", "set_by": "plugin", "change_risk": 1, "plugin_key": true, "meaning": "For AI TaskNotes, a value only in the closed state"},
    "timeEstimate": {"required": [], "type": "int", "set_by": "hq", "change_risk": 1, "plugin_key": true, "meaning": "Minutes"},
    "ForToday": {"required": [], "type": "bool", "set_by": "hq", "change_risk": 1, "variant_only": "human", "meaning": "Marks a task for today"},
    "waiting": {"required": [], "type": "bool", "set_by": "hq", "change_risk": 1, "variant_only": "human", "meaning": "Waiting on an external party"},
    "dateCreated": {"required": [], "type": "date_or_datetime", "set_by": "plugin", "change_risk": 1, "plugin_key": true},
    "dateModified": {"required": [], "type": "date_or_datetime", "set_by": "plugin", "change_risk": 1, "plugin_key": true}
   },
   "state_combination_fields": ["status", "owner", "hq_todo"],
   "state_combinations": [["to-do", "{hq-owner}", "decide"], ["to-do", "{hq-owner}", "dispatch"], ["to-do", "ai", "none"], ["in-progress", "ai", "none"], ["in-progress", "{hq-owner}", "review"], ["done", "none", "none"]],
   "state_combinations_apply_to": "ai",
   "completed_date_field": "completedDate",
   "closed_state": ["done", "none", "none"],
   "plugin_managed": ["timeEntries", "recurrence", "recurrence_anchor", "recurrence_parent", "complete_instances", "skipped_instances", "reminders", "pomodoros", "tasknotes_manual_order", "icsEventId", "googleCalendarEventId"],
   "deprecated": {"blocked_by": "blockedBy", "project": "projects", "hq": "hq_todo", "priority": "(removed)", "urgency": "(removed)"}
  },
  "project_status": {
   "match": {"under": "{projects-folder}", "filename": "STATUS.md"},
   "order": ["project_id", "status", "phase", "next_action", "next_deadline", "updated", "draft_by", "llm_model"],
   "fields": {
    "project_id": {"required": ["all"], "type": "text", "pattern_from": "project-id-pattern", "set_by": "agent", "change_risk": 1},
    "status": {"required": ["all"], "type": "enum", "values_from": "project-status", "set_by": "hq", "change_risk": 2},
    "phase": {"required": ["all"], "type": "enum", "values_from": "project-phases", "set_by": "hq", "change_risk": 2},
    "next_action": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "One concrete action"},
    "next_deadline": {"required": ["all"], "type": "date", "allow_empty": true, "set_by": "hq", "change_risk": 2},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "draft_by": {"required": [], "type": "link_or_text", "set_by": "agent", "change_risk": 1, "meaning": "TaskNote link or legacy ID for an AI-written draft"},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "If draft_by is set, the name of the model that made that draft"}
   },
   "deprecated": {"priority": "(removed)"}
  },
  "project_roadmap": {
   "match": {"under": "{projects-folder}", "filename": "ROADMAP.md"},
   "order": ["project_id", "type", "approved_version", "updated", "llm_model"],
   "fields": {
    "project_id": {"required": ["all"], "type": "text", "pattern_from": "project-id-pattern", "set_by": "agent", "change_risk": 1},
    "type": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"project-roadmap": "Project roadmap"}},
    "approved_version": {"required": ["all"], "type": "version", "allow_empty": true, "set_by": "agent", "change_risk": 1, "meaning": "Filled only when HQ's original approval text exists. Unapproved is \"\""},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "If written by AI, the model name"}
   }
  },
  "portfolio_roadmap": {
   "match": {"type_value": ["portfolio-roadmap"]},
   "order": ["type", "approved_version", "updated", "llm_model"],
   "fields": {
    "type": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"portfolio-roadmap": "Portfolio roadmap"}},
    "approved_version": {"required": ["all"], "type": "version", "allow_empty": true, "set_by": "agent", "change_risk": 1, "meaning": "Filled only when HQ's original approval text exists. Unapproved is \"\""},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "If written by AI, the model name"}
   }
  },
  "project_readme": {
   "match": {"under": "{projects-folder}", "filename": "README.md", "depth_max": 3, "has_key": "project_id"},
   "order": ["project_id", "type", "collaborators", "track", "created", "draft_by", "llm_model"],
   "fields": {
    "project_id": {"required": ["all"], "type": "text", "pattern_from": "project-id-pattern", "set_by": "agent", "change_risk": 1},
    "type": {"required": ["all"], "type": "enum", "set_by": "hq", "change_risk": 1, "values": {"project-brief": "Ordinary project", "collaboration": "Joint research project"}},
    "collaborators": {"required": [], "type": "list", "item_type": "link_or_text", "set_by": "hq", "change_risk": 1, "meaning": "Link when a person or institution document exists"},
    "track": {"required": [], "type": "enum", "values_from": "readme-tracks", "set_by": "hq", "change_risk": 1},
    "created": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "draft_by": {"required": [], "type": "link_or_text", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "If draft_by is set, the name of the model that made that draft"}
   },
   "deprecated": {"codename": "(removed)", "partners": "collaborators"}
  },
  "decision_log": {
   "match": {"filename": "Decisions.md"},
   "order": ["project_id", "type", "updated", "llm_model"],
   "fields": {
    "project_id": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "Project ID or HQ"},
    "type": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"decision-log": "Decision log"}},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "If written by AI, the model name"}
   }
  },
  "index": {
   "match": {"type_value": ["project-index", "technical-index", "theory-index", "repository-catalog"]},
   "order": ["type", "updated", "llm_model"],
   "fields": {
    "type": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"project-index": "Project status table", "technical-index": "Technical Wiki index", "theory-index": "Theory Wiki index", "repository-catalog": "Repository list"}},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "If written by AI, the model name"}
   }
  },
  "repo_card": {
   "match": {"under": "{technical-wiki}", "type_value": ["repo-card"]},
   "order": ["type", "repo", "remote", "local_path", "branch", "last_checked_commit", "status", "updated", "llm_model"],
   "fields": {
    "type": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"repo-card": "Repository card"}},
    "repo": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "remote": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "local_path": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "branch": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "last_checked_commit": {"required": ["all"], "type": "commit", "set_by": "agent", "change_risk": 1},
    "status": {"required": ["all"], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"active": "In use", "archived": "Archived"}},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "If written by AI, the model name"}
   }
  },
  "technical_wiki": {
   "match": {"under": "{technical-wiki}"},
   "order": ["title", "type", "tags", "source_project", "status", "created", "updated", "related", "llm_model"],
   "fields": {
    "title": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1},
    "type": {"required": [], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"note": "Ordinary technical note", "external-media": "External material summary"}},
    "tags": {"required": ["all"], "type": "list", "item_type": "text", "set_by": "agent", "change_risk": 1},
    "source_project": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "ID of the project where it first appeared"},
    "status": {"required": [], "type": "enum", "set_by": "agent", "change_risk": 1, "values": {"active": "Maintained", "done": "Complete"}},
    "created": {"required": [], "type": "date", "set_by": "agent", "change_risk": 1},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "related": {"required": [], "type": "list", "item_type": "link", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "If written by AI, the model name"}
   },
   "missing_frontmatter": "For notes without frontmatter, add every field in order; if a value is unknown, keep only the key and leave it empty"
  },
  "theory_wiki": {
   "match": {"under": "{theory-wiki}"},
   "order": ["author", "affiliation", "tags", "created", "updated", "language", "sources", "llm_model"],
   "fields": {
    "author": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "affiliation": {"required": ["all"], "type": "text", "set_by": "agent", "change_risk": 1},
    "tags": {"required": ["all"], "type": "list", "item_type": "text", "set_by": "agent", "change_risk": 1},
    "created": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "updated": {"required": ["all"], "type": "date", "set_by": "agent", "change_risk": 1},
    "language": {"required": ["all"], "type": "enum", "values_from": "languages", "set_by": "agent", "change_risk": 1},
    "sources": {"required": ["all"], "type": "list", "item_type": "text", "set_by": "agent", "change_risk": 1},
    "llm_model": {"required": [], "type": "text", "set_by": "agent", "change_risk": 1, "meaning": "If written by AI, the model name"}
   },
   "deprecated": {"aliases": "(removed)", "translation": "(removed)", "related": "(removed)"}
  }
 },
 "no_frontmatter": ["_AI/CONTEXT.md"],
 "hq_decided": [
  {"id": "Q1", "kind": "tasknote", "field": "status", "decision": "Change the legacy value shelved to delayed and add delayed to the allowed values"},
  {"id": "Q2", "kind": "tasknote", "field": "urgency, ForToday, waiting, blockedBy", "decision": "Remove only urgency. Keep ForToday and waiting as true/false and keep blockedBy as a separate link field"},
  {"id": "Q3", "kind": "tasknote", "field": "projects", "decision": "Use a link when a target document exists; text only when a link cannot be made (link_or_text)"},
  {"id": "Q4", "kind": "(all)", "field": "priority", "decision": "Removed from every kind"},
  {"id": "Q5", "kind": "project_readme", "field": "type", "decision": "A joint research README is collaboration"},
  {"id": "Q6", "kind": "technical_wiki", "field": "(all)", "decision": "Add every field in order to notes without frontmatter; never write explanatory sentences in status"},
  {"id": "Q7", "kind": "(all)", "field": "Empty optional values", "decision": "Keep the key of an optional field even without a value; leave only the value empty"},
  {"id": "Q8", "kind": "project_roadmap, portfolio_roadmap", "field": "(all)", "decision": "Minimal fields project_id, type, approved_version, updated, llm_model (2026-09-23, roadmap proposal 02 Q1)"}
 ]
}
